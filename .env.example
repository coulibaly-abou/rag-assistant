# Copier ce fichier en .env pour modifier la configuration (facultatif : valeurs par défaut ci-dessous).
# Après modification : docker compose up -d

# Modèles Ollama (téléchargés automatiquement au démarrage)
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# Indexation : taille d'un chunk et chevauchement, en mots
COLLECTION_NAME=cours
CHUNK_SIZE=300
CHUNK_OVERLAP=50
# Indexer data/ automatiquement au démarrage de l'API
AUTO_INGEST=true

# Recherche et génération
TOP_K=5
MIN_SCORE=0.0
TEMPERATURE=0.1
NUM_CTX=4096
REQUEST_TIMEOUT=300

# Nom du modèle affiché dans Open WebUI
RAG_MODEL_NAME=rag-cours

# Hors Docker uniquement (notebook, scripts lancés sur le PC) :
# OLLAMA_URL=http://localhost:11434
# QDRANT_URL=http://localhost:6333
# DATA_DIR=data
